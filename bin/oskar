#!/bin/bash

# oskar — one user-facing lifecycle command for the on-screen keyboard.
#
#   oskar setup [--migrate-source] [--prebuilt <tarball>]
#                                    activate; idempotent
#   oskar upgrade [--prebuilt <tarball>]
#                                    reload helper + shell after a
#                                          package/source update
#   oskar status                     report; changes nothing
#   oskar doctor                     diagnose; read-only, exits 1
#                                          when something is wrong
#   oskar teardown                   deactivate, keep config/state
#   oskar record ...                 the install record (install.sh and
#                                          uninstall.sh ask through it)
#
# The same script serves both worlds and tells them apart by its own
# location: installed as /usr/bin/oskar it manages the packaged
# payload (/usr/share/oskar/plugin, /usr/lib/oskar); run from
# a source checkout (directly or through the ~/.local/bin symlink
# install.sh maintains) it manages that checkout. Activation is always a
# user action — a package hook runs as root and must not guess a user's
# session bus (the .install message only points here).
#
# Registration is the stable plugin id's symlink in
# ~/.config/omarchy/plugins. This script replaces a symlink without
# asking (the old target survives untouched — that is recoverable), and
# REFUSES to touch a real directory: that is either a `git clone` made by
# `omarchy plugin add` or a developer's checkout, not ours to manage.
# Teardown unlinks the registration only when it resolves to the payload
# this script owns. Config (~/.config/oskar) and state
# (~/.local/state/oskar) are the user's and are never touched.

set -euo pipefail

PLUGIN_ID="io.github.vladkarok.oskar"
UNIT="oskar.service"
REGISTRATION="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
USER_UNIT="$HOME/.config/systemd/user/$UNIT"
PACKAGED_UNIT="/usr/lib/systemd/user/$UNIT"
SOURCE_HELPER="$HOME/.local/libexec/oskar-daemon"
CLI_LINK="$HOME/.local/bin/oskar"
SOCKET="${XDG_RUNTIME_DIR:-$HOME/.run}/oskar/control.sock"
RECORD="${XDG_STATE_HOME:-$HOME/.local/state}/oskar/install-record"
# The newest protocol the helper this tree builds speaks. The helper also
# accepts the one before (a panel is allowed to lag its helper), so this
# only has to match the helper, never the panel.
PROTOCOL_VERSION="7"

say() { printf 'oskar: %s\n' "$*"; }
warn() { printf 'oskar: WARNING: %s\n' "$*" >&2; }
die() { printf 'oskar: %s\n' "$*" >&2; exit 1; }

self_path() { realpath "$0" 2>/dev/null || readlink -f "$0"; }

# --- the install record --------------------------------------------------------
#
# Every path this product writes outside its checkout or package is a
# name someone else may already use. A path is OSKar's only while the
# install record lists it AND it is exactly what was recorded: a regular
# file with the recorded sha256, or a symlink with the recorded link
# text. No record line, an edit since, a replacement, a directory: not
# ours. Nothing is inferred from a file's name or content. What is not
# ours is never overwritten or deleted; with explicit consent it is moved
# aside under a name nothing else holds. install.sh and uninstall.sh ask
# through `oskar record`, so the rule lives here once, and a failing call
# reads as "not ours".
#
# The record is one line per path, "<kind>\t<digest>\t<absolute path>":
# kind "file" (digest: sha256 of the bytes) or "link" (digest: the link
# text). It is replaced whole through a temp file and a rename, so a
# reader never meets half of it. The record is per user, not per
# checkout: files one checkout installed match it when another checkout
# installs, which is how an install moves between checkouts.

record_path_ok() {
  [[ "$1" == /* && "$1" != *$'\t'* && "$1" != *$'\n'* ]]
}

# Lexical only: symlinks along the path are not resolved, so a record
# line names the path the writer used, spelled canonically.
record_norm() { realpath -m -s -- "$1"; }

# "<kind>\t<digest>" for what is at the path now; fails for anything
# that is neither a regular file nor a symlink (absent, a directory, a
# socket), and for a link text the line format cannot carry.
record_state() {
  local text sum
  if [[ -L "$1" ]]; then
    text="$(readlink -- "$1" && printf x)" || return 1
    text="${text%x}"
    text="${text%$'\n'}"
    [[ -n "$text" && "$text" != *$'\t'* && "$text" != *$'\n'* ]] || return 1
    printf 'link\t%s\n' "$text"
  elif [[ -f "$1" ]]; then
    sum="$(sha256sum < "$1" 2>/dev/null)" || return 1
    sum="${sum%% *}"
    [[ ${#sum} -eq 64 ]] || return 1
    printf 'file\t%s\n' "$sum"
  else
    return 1
  fi
}

# "<kind>\t<digest>" the record holds for a normalised path.
record_lookup() {
  [[ -f "$RECORD" ]] || return 1
  local kind digest path
  while IFS=$'\t' read -r kind digest path || [[ -n "$kind" ]]; do
    if [[ "$path" == "$1" ]]; then
      printf '%s\t%s\n' "$kind" "$digest"
      return 0
    fi
  done < "$RECORD"
  return 1
}

record_matches() {
  record_path_ok "${1:-}" || return 1
  local path want have
  path="$(record_norm "$1")" || return 1
  want="$(record_lookup "$path")" || return 1
  have="$(record_state "$path")" || return 1
  [[ "$have" == "$want" ]]
}

# write: record what each path is now, replacing earlier lines for the
# same paths. forget: drop their lines. The file goes when it is empty.
record_update() {
  local op="$1" path state line
  shift
  local -A named=()
  local -a lines=()
  for path in "$@"; do
    record_path_ok "$path" || die "record: not an absolute path: $path"
    path="$(record_norm "$path")"
    named["$path"]=1
    if [[ "$op" == write ]]; then
      state="$(record_state "$path")" \
        || die "record: $path is neither a file nor a symlink; nothing recorded"
      lines+=("$state"$'\t'"$path")
    fi
  done
  [[ "$op" == write || -f "$RECORD" ]] || return 0
  local dir tmp kind digest
  dir="$(dirname "$RECORD")"
  [[ -d "$dir" ]] || mkdir -p -m 0700 "$dir" || die "record: cannot create $dir"
  tmp="$(mktemp "$dir/.install-record.XXXXXX")" || die "record: cannot write in $dir"
  if ! {
    if [[ -f "$RECORD" ]]; then
      while IFS=$'\t' read -r kind digest path || [[ -n "$kind" ]]; do
        case "$kind" in file|link) ;; *) continue ;; esac
        [[ -n "$digest" && "$path" == /* ]] || continue
        [[ -z "${named[$path]:-}" ]] || continue
        printf '%s\t%s\t%s\n' "$kind" "$digest" "$path"
      done < "$RECORD"
    fi
    for line in ${lines[@]+"${lines[@]}"}; do
      printf '%s\n' "$line"
    done
  } > "$tmp"; then
    rm -f -- "$tmp"
    die "record: cannot write $tmp"
  fi
  if [[ -s "$tmp" ]]; then
    chmod 0600 "$tmp" && mv -f -- "$tmp" "$RECORD" \
      || { rm -f -- "$tmp"; die "record: cannot replace $RECORD"; }
  else
    rm -f -- "$tmp" "$RECORD"
  fi
}

# Out of the way, never gone, never onto something else: the path moves
# to <path>.<word>-<timestamp>, or .1, .2, … after it when that name is
# taken, and the move is proven (source gone, destination there) before
# anyone is told it happened. Prints the new name.
record_aside() {
  local path="$1" word="$2" stamp dest n=0
  [[ "$word" =~ ^[a-z]+$ ]] || die "aside: the word must be lowercase letters: $word"
  [[ -e "$path" || -L "$path" ]] || die "aside: nothing at $path"
  stamp="$(date +%Y%m%d-%H%M%S)"
  dest="$path.$word-$stamp"
  while [[ -e "$dest" || -L "$dest" ]]; do
    n=$((n + 1))
    dest="$path.$word-$stamp.$n"
  done
  if ! mv -T -n -- "$path" "$dest" \
      || [[ -e "$path" || -L "$path" ]] \
      || ! [[ -e "$dest" || -L "$dest" ]]; then
    die "could not move $path aside as $dest; it is left where it was"
  fi
  printf '%s\n' "$dest"
}

cmd_record() {
  local usage="usage: oskar record {matches <path> | write <path>... | \
forget <path>... | aside <path> <word>}"
  case "${1:-}" in
    matches) [[ $# -eq 2 ]] || die "$usage"; record_matches "$2" ;;
    write|forget) [[ $# -ge 2 ]] || die "$usage"; record_update "$@" ;;
    aside) [[ $# -eq 3 ]] || die "$usage"; record_aside "$2" "$3" ;;
    *) die "$usage" ;;
  esac
}

# --- the unit systemd acts on ------------------------------------------------
#
# systemctl enable/restart/stop/disable act on whatever file systemd
# resolves for oskar.service, which need not be the one OSKar wrote. It
# is OSKar's when it is the package's (pacman owns /usr/lib) or the user
# unit the install record proves unchanged. Anything else — a user unit
# OSKar did not install or one edited since, an /etc override, a masked
# unit, no unit at all — is not ours to switch on or off.
UNIT_FRAGMENT=""
unit_is_ours() {
  UNIT_FRAGMENT="$(systemctl --user show -p FragmentPath --value "$UNIT" 2>/dev/null || true)"
  [[ -n "$UNIT_FRAGMENT" ]] || return 1
  [[ "$UNIT_FRAGMENT" == "$PACKAGED_UNIT" ]] && return 0
  [[ -f "$USER_UNIT" ]] || return 1
  [[ "$(realpath -e -- "$UNIT_FRAGMENT" 2>/dev/null)" \
    == "$(realpath -e -- "$USER_UNIT" 2>/dev/null)" ]] || return 1
  record_matches "$USER_UNIT"
}

unit_not_ours_reason() {
  if [[ -z "$UNIT_FRAGMENT" ]]; then
    printf 'systemd has no %s unit' "$UNIT"
  else
    printf 'systemd resolves %s to %s, which OSKar did not install (or which was changed since)' \
      "$UNIT" "$UNIT_FRAGMENT"
  fi
}

# A user unit named oskar.service overrides the packaged one. When the
# record does not prove it OSKar's, nothing here moves it, flag or not.
foreign_user_unit() {
  [[ -e "$USER_UNIT" || -L "$USER_UNIT" ]] && ! record_matches "$USER_UNIT"
}
FOREIGN_UNIT_MSG="$USER_UNIT is a user unit named $UNIT that OSKar did \
not install (or that was edited since OSKar installed it), and it \
overrides the packaged unit. OSKar will not touch it: rename or remove it \
yourself, then rerun this command"


detect_mode() {
  SELF="$(self_path)"
  if [[ "$SELF" == /usr/bin/oskar && -d /usr/share/oskar/plugin ]]; then
    MODE="packaged"
    PAYLOAD="/usr/share/oskar/plugin"
    HELPER="/usr/lib/oskar/oskar-daemon"
    return
  fi
  local root
  root="$(cd "$(dirname "$SELF")/.." && pwd)"
  if [[ -f "$root/daemon/Cargo.toml" && -f "$root/Panel.qml" ]]; then
    MODE="source"
    PAYLOAD="$root"
    HELPER="$SOURCE_HELPER"
    return
  fi
  die "cannot locate the installation (self: $SELF); run from /usr/bin, \
a checkout, or the ~/.local/bin symlink install.sh maintains"
}

registration_target() {
  # Prints the symlink's resolved target, or nothing when the
  # registration is absent or is a real directory.
  [[ -L "$REGISTRATION" ]] || return 0
  realpath "$REGISTRATION" 2>/dev/null || return 0
}

registration_link_text() {
  # The symlink's own text, even when its target no longer resolves —
  # a payload removed under a live registration leaves a dangling link
  # whose realpath is empty but whose text still names our payload.
  [[ -L "$REGISTRATION" ]] || return 0
  readlink "$REGISTRATION"
}

# `omarchy plugin add` clones the repo straight into the registration path,
# so the registration is a real directory that IS this install's payload:
# already registered, and removed by `omarchy plugin remove`, not by us.
registration_is_payload_clone() {
  [[ -d "$REGISTRATION" && ! -L "$REGISTRATION" ]] || return 1
  local reg payload
  reg="$(cd "$REGISTRATION" 2>/dev/null && pwd -P)"
  payload="$(cd "$PAYLOAD" 2>/dev/null && pwd -P)"
  [[ -n "$reg" && "$reg" == "$payload" ]]
}

graphical_session_active() {
  systemctl --user --quiet is-active graphical-session.target 2>/dev/null
}

preflight() {
  local missing=() pkgs=()
  local probe
  for probe in "omarchy:omarchy" "omarchy-shell:omarchy" "hyprctl:hyprland" \
    "systemctl:systemd" "jq:jq" "wl-copy:wl-clipboard" "wl-paste:wl-clipboard"; do
    local cmd="${probe%%:*}" pkg="${probe##*:}"
    command -v "$cmd" >/dev/null 2>&1 || { missing+=("$cmd"); pkgs+=("$pkg"); }
  done
  # No grep -q here: it exits at the first match and the writing ldconfig
  # dies of SIGPIPE, which pipefail turns into a false "missing".
  if ! ldconfig -p 2>/dev/null | grep 'libxkbcommon\.so' >/dev/null; then
    missing+=("libxkbcommon.so.0"); pkgs+=("libxkbcommon")
  fi
  if ((${#missing[@]})); then
    say "missing runtime dependencies:"
    local i
    for i in "${!missing[@]}"; do say "  ${missing[$i]}  (pacman: ${pkgs[$i]})"; done
    die "install the packages above, then rerun: oskar setup"
  fi
}

report_legacy_source() {
  # Packaged mode: a source install's unit or helper that the record
  # proves OSKar's. Its user unit OVERRIDES the packaged unit while it
  # exists, so the packaged helper can be enabled but never runs.
  # Removal is explicit (--migrate-source) and recoverable: the unit is
  # renamed, never deleted.
  local found=0
  if record_matches "$USER_UNIT"; then found=1; say "source-install unit: $USER_UNIT"; fi
  if record_matches "$SOURCE_HELPER"; then found=1; say "source-install helper: $SOURCE_HELPER"; fi
  ((found))
}

migrate_source() {
  # Acts only on what the record proves OSKar's; anything else under
  # these names is left exactly where it is.
  local dest
  if record_matches "$USER_UNIT"; then
    dest="$(record_aside "$USER_UNIT" migrated)" || exit 1
    record_update forget "$USER_UNIT"
    say "user unit moved aside: $dest"
  fi
  if record_matches "$SOURCE_HELPER"; then
    rm -f -- "$SOURCE_HELPER"
    record_update forget "$SOURCE_HELPER"
    say "source helper binary removed (rebuild it any time from the checkout)"
  elif [[ -e "$SOURCE_HELPER" || -L "$SOURCE_HELPER" ]]; then
    say "$SOURCE_HELPER left in place: OSKar did not install it, or it changed since"
  fi
  # The ~/.local/bin symlink shadows /usr/bin on default PATHs; left
  # behind, the next bare `oskar setup` resolves to the source
  # copy and silently re-creates the source install just moved away.
  if record_matches "$CLI_LINK"; then
    rm -f -- "$CLI_LINK"
    record_update forget "$CLI_LINK"
    say "source lifecycle symlink removed from ~/.local/bin"
  elif [[ -e "$CLI_LINK" || -L "$CLI_LINK" ]]; then
    warn "$CLI_LINK is not the command OSKar installed (or it changed \
since); left in place (it shadows /usr/bin/oskar on your PATH — call the \
packaged one by its full path, or move that file yourself)"
  fi
  systemctl --user daemon-reload
}


ensure_registration() {
  local target
  target="$(registration_target)"
  if registration_is_payload_clone; then
    say "plugin registration is this install's own clone (omarchy plugin add)"
    return
  fi
  [[ -e "$REGISTRATION" && ! -L "$REGISTRATION" ]] && \
    die "$REGISTRATION is a real directory (a git clone or a checkout); \
this script manages symlinks only — remove or rename it yourself if you \
want the $MODE payload registered instead"
  if [[ "$target" == "$PAYLOAD" ]]; then
    say "plugin registration already points at the $MODE payload"
    return
  fi
  # The registration path is named by OUR plugin id, so a symlink there
  # is a registration of this product whatever payload it names; a real
  # directory was refused above. Re-pointing replaces the link only.
  [[ -n "$target" ]] && say "re-pointing registration (was: $target)"
  mkdir -p "$(dirname "$REGISTRATION")"
  ln -sfn "$PAYLOAD" "$REGISTRATION"
  say "registered $PLUGIN_ID -> $PAYLOAD"
}

rescan_and_enable_plugin() {
  if omarchy-shell shell rescanPlugins >/dev/null 2>&1; then
    say "shell rescanned plugins"
  else
    warn "shell not answering; the plugin is picked up on the next shell start"
  fi
  if omarchy plugin enable "$PLUGIN_ID" >/dev/null 2>&1; then
    say "plugin enabled in the shell"
  else
    # The shell occasionally has not finished absorbing the rescan when
    # the first enable lands; one retry after a beat clears it, and a
    # persistent failure stays a warning (the registration is what setup
    # guarantees — rerunning setup converges).
    sleep 1
    if omarchy plugin enable "$PLUGIN_ID" >/dev/null 2>&1; then
      say "plugin enabled in the shell (second attempt after rescan)"
    else
      warn "could not enable the plugin (shell down?); it stays registered"
    fi
  fi
}

# Setup's job is a running OSKar helper; with a unit that is not OSKar's
# in the way it cannot do it, so it stops before registering anything.
require_own_unit() {
  systemctl --user daemon-reload
  unit_is_ours || die "$(unit_not_ours_reason); OSKar will not enable or \
start it. Rename or remove that unit yourself (or reinstall OSKar's), then \
rerun: oskar setup"
}

enable_unit() {
  require_own_unit
  systemctl --user enable "$UNIT" >/dev/null 2>&1 || true
  if graphical_session_active; then
    systemctl --user reset-failed "$UNIT" 2>/dev/null || true
    systemctl --user restart "$UNIT"
    say "helper restarted"
  else
    say "helper enabled; it starts with your next graphical session"
  fi
}

# The prebuilt helper a source-mode install.sh may take in place of a
# build (`--prebuilt <tarball>` on setup and upgrade): the release's
# no-toolchain channel, threaded through unchanged.
PREBUILT=""
take_prebuilt() {
  [[ -n "${1:-}" ]] || die "--prebuilt needs the helper tarball's path"
  [[ -f "$1" ]] || die "no such file: $1"
  PREBUILT="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
}
run_install_sh() {
  if [[ -n "$PREBUILT" ]]; then
    bash "$PAYLOAD/install.sh" --prebuilt "$PREBUILT"
  else
    bash "$PAYLOAD/install.sh"
  fi
}

cmd_setup() {
  local migrate=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --migrate-source) migrate=1; shift ;;
      --prebuilt) take_prebuilt "${2:-}"; shift 2 ;;
      *) die "usage: oskar setup [--migrate-source] [--prebuilt <tarball>]" ;;
    esac
  done
  detect_mode
  preflight

  if [[ "$MODE" == "packaged" ]]; then
    foreign_user_unit && die "$FOREIGN_UNIT_MSG"
    if report_legacy_source; then
      if ((migrate)); then
        migrate_source
      else
        die "a source install overrides the packaged unit; rerun with \
--migrate-source to move its unit aside (kept as *.migrated-<timestamp>) \
and remove its helper and command"
      fi
    fi
  fi

  if [[ "$MODE" == "source" ]]; then
    if [[ -x /usr/bin/oskar ]]; then
      warn "a packaged install also exists; a bare 'oskar' may resolve \
to /usr/bin first on your PATH — call this one by its full path"
    fi
    run_install_sh || die "install.sh did not finish; nothing was activated"
  fi

  require_own_unit
  ensure_registration
  rescan_and_enable_plugin
  enable_unit
  say "setup complete ($MODE payload)"
}

cmd_upgrade() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prebuilt) take_prebuilt "${2:-}"; shift 2 ;;
      *) die "usage: oskar upgrade [--prebuilt <tarball>]" ;;
    esac
  done
  detect_mode
  local target
  target="$(registration_target)"
  # An `omarchy plugin add` clone is this install's registration itself.
  registration_is_payload_clone && target="$PAYLOAD"
  if [[ "$target" != "$PAYLOAD" ]]; then
    die "registration does not point at the \
$MODE payload (has: ${target:-none}); run: oskar setup"
  fi
  if [[ "$MODE" == "packaged" ]]; then
    foreign_user_unit && die "$FOREIGN_UNIT_MSG"
    if report_legacy_source; then
      die "a source install overrides the packaged unit; restart would load \
incompatible halves; run: oskar setup --migrate-source"
    fi
  fi

  if [[ "$MODE" == "source" ]]; then
    run_install_sh || die "install.sh did not finish; nothing was restarted"
  else
    systemctl --user daemon-reload
    say "unit definitions reloaded"
  fi

  # Restarting is part of an upgrade, not the whole of it: a unit that is
  # not OSKar's is named and left alone, and the shell still reloads.
  if ! systemctl --user --quiet is-active "$UNIT" 2>/dev/null; then
    say "helper not running; nothing to restart"
  elif ! unit_is_ours; then
    warn "$(unit_not_ours_reason); not restarting it"
  else
    systemctl --user reset-failed "$UNIT" 2>/dev/null || true
    systemctl --user restart "$UNIT"
    say "helper restarted"
  fi

  # The panel is keepLoaded: a live shell keeps the OLD QML until it is
  # restarted. Tolerate a non-interactive or headless context.
  if omarchy restart shell >/dev/null 2>&1; then
    say "shell restarted (QML reloaded)"
  else
    warn "could not restart the shell; run: omarchy restart shell"
  fi
  say "upgrade complete ($MODE payload)"
}

protocol_probe() {
  # One hello roundtrip against the live helper. Prints the reply line.
  command -v socat >/dev/null 2>&1 || { printf 'unknown (socat not installed)\n'; return; }
  [[ -S "$SOCKET" ]] || { printf 'no socket\n'; return; }
  printf 'hello %s\n' "$PROTOCOL_VERSION" |
    timeout 2 socat -t1 - UNIX-CONNECT:"$SOCKET" 2>/dev/null | head -n1
}

cmd_status() {
  detect_mode
  local payload_state="present" reg target kind="absent"
  [[ -d "$PAYLOAD" ]] || payload_state="MISSING"
  if registration_is_payload_clone; then
    kind="plugin clone (this install)"
    target="$(cd "$REGISTRATION" && pwd)"
  elif [[ -e "$REGISTRATION" && ! -L "$REGISTRATION" ]]; then
    kind="directory (not ours to manage)"
    target="$(cd "$REGISTRATION" && pwd)"
  elif [[ -L "$REGISTRATION" ]]; then
    kind="symlink"
    target="$(registration_target)"
  else
    target=""
  fi
  # An empty answer (shell down, malformed output) reads as "not listed":
  # the honest fallback for a report that must stay total.
  local plugin
  plugin="$(omarchy plugin list --json 2>/dev/null |
    jq -r --arg id "$PLUGIN_ID" '.[] | select(.id == $id) |
      if .enabled then "enabled" else "disabled" end' 2>/dev/null || true)"
  [[ -n "$plugin" ]] || plugin="not listed"
  local unit_enabled unit_active
  unit_enabled="$(systemctl --user is-enabled "$UNIT" 2>/dev/null || true)"
  unit_active="$(systemctl --user is-active "$UNIT" 2>/dev/null || true)"
  local helper_state="present"
  [[ -f "$HELPER" ]] || helper_state="MISSING"
  local reply
  # A failing transport (stale socket, timeout, socat's own nonzero)
  # must not kill the report under set -e: the probe's own empty
  # answer already reads as "not answering" below.
  reply="$(protocol_probe)" || reply=""
  local proto="ok (protocol $PROTOCOL_VERSION)"
  if [[ "$reply" == "hello $PROTOCOL_VERSION" ]]; then
    :
  elif [[ "$reply" == "no socket" || -z "$reply" ]]; then
    proto="not answering (helper down?)"
  else
    proto="MISMATCH (reply: $reply)"
  fi

  say "mode:            $MODE"
  say "payload:         $PAYLOAD ($payload_state)"
  say "helper:          $HELPER ($helper_state)"
  say "registration:    $REGISTRATION ($kind -> ${target:-none})"
  say "plugin state:    $plugin"
  say "unit enabled:    ${unit_enabled:-unknown}"
  say "unit active:     ${unit_active:-unknown}"
  say "socket:          $SOCKET ($([[ -S "$SOCKET" ]] && echo present || echo absent))"
  say "protocol:        $proto"
  if [[ "$MODE" == "packaged" ]]; then
    if foreign_user_unit; then
      warn "$FOREIGN_UNIT_MSG"
    elif report_legacy_source; then
      warn "a legacy source install overrides the packaged unit; \
setup --migrate-source moves it aside"
    fi
  fi
}

cmd_teardown() {
  detect_mode
  if omarchy plugin disable "$PLUGIN_ID" >/dev/null 2>&1; then
    say "plugin disabled in the shell"
  else
    say "plugin not enabled (or shell down)"
  fi
  # Teardown's other steps stand on their own: a unit that is not
  # OSKar's is named and left running, and the rest still happens.
  if unit_is_ours; then
    if systemctl --user disable --now "$UNIT" >/dev/null 2>&1; then
      say "unit disabled and stopped"
    else
      say "unit already inactive"
    fi
  elif [[ -z "$UNIT_FRAGMENT" ]]; then
    say "no $UNIT unit installed; nothing to disable"
  else
    warn "$(unit_not_ours_reason); left as it is"
  fi
  if registration_is_payload_clone; then
    say "the plugin clone stays; remove it with: omarchy plugin remove $PLUGIN_ID"
  elif [[ -e "$REGISTRATION" && ! -L "$REGISTRATION" ]]; then
    warn "$REGISTRATION is a real directory; left untouched"
  elif [[ -L "$REGISTRATION" ]]; then
    local target text
    target="$(registration_target)"
    text="$(registration_link_text)"
    if [[ "$target" == "$PAYLOAD" ]] || [[ -z "$target" && "$text" == "$PAYLOAD" ]]; then
      rm "$REGISTRATION"
      say "registration unlinked (pointed at the $MODE payload)"
    else
      warn "registration points at ${target:-$text}, not the $MODE payload; left alone"
    fi
  else
    say "no registration to remove"
  fi
  say "teardown complete; config and state preserved"
}

# --- doctor -------------------------------------------------------------------
#
# One read-only diagnosis against the live session: every check names a
# failure this project has actually shipped or hit, prints
#   ok <what> — <evidence>
#   FAIL <what>: <diagnosis>; try: <the one fix>
#   unknown <what>: <why it cannot be checked>
# and the command exits 0 only when nothing failed and nothing is
# unknown (an uncheckable health claim is not a healthy verdict).
#
# The OSKAR_DOCTOR_* environment variables are TEST SEAMS, not
# configuration: each points one check at a fixture (a bogus socket, a
# dangling symlink, a journal file) so a negative case can be proven on
# a healthy host without breaking the real thing. Unset = the real path.

DOCTOR_FAILS=0
DOCTOR_UNKNOWNS=0

doc_ok()      { printf 'ok      %s — %s\n' "$1" "$2"; }
doc_fail()    { printf 'FAIL    %s: %s\n' "$1" "$2"; DOCTOR_FAILS=$((DOCTOR_FAILS + 1)); }
doc_unknown() { printf 'unknown %s: %s\n' "$1" "$2"; DOCTOR_UNKNOWNS=$((DOCTOR_UNKNOWNS + 1)); }

doctor_hello() {
  # First reply line to this script's expected hello. Sentinels for the
  # honest cannot-answer cases; anything else is the helper's own reply.
  # socat's failure (a stale socket file) must not abort the run.
  command -v socat >/dev/null 2>&1 || { printf 'no socat\n'; return; }
  [[ -S "$DOCTOR_SOCKET" ]] || { printf 'no socket\n'; return; }
  local reply
  reply="$(printf 'hello %s\n' "$PROTOCOL_VERSION" |
    timeout 2 socat -t1 - UNIX-CONNECT:"$DOCTOR_SOCKET" 2>/dev/null |
    head -n1 || true)"
  [[ -n "$reply" ]] || reply="silent"
  printf '%s\n' "$reply"
}

doctor_query() {
  # One command line in, its reply line out; empty = no answer. The
  # queries doctor sends (caps, keyboards) are read-only against the
  # helper's installed state. The hello rides the SAME connection: the
  # helper executes nothing before a completed handshake, so a bare
  # query on a fresh connection would get "err hello first" and read
  # as a broken keymap instead of a missing handshake.
  command -v socat >/dev/null 2>&1 || return 0
  [[ -S "$DOCTOR_SOCKET" ]] || return 0
  printf 'hello %s\n%s\n' "$PROTOCOL_VERSION" "$1" |
    timeout 2 socat -t1 - UNIX-CONNECT:"$DOCTOR_SOCKET" 2>/dev/null |
    sed -n 2p || true
}

doctor_unit() {
  local what="service unit" state
  state="$(systemctl --user is-enabled "$DOCTOR_UNIT_D" 2>/dev/null || true)"
  if [[ "$state" == "not-found" || -z "$state" ]]; then
    doc_fail "$what" "no user unit named $DOCTOR_UNIT_D is installed, so \
nothing starts the helper; try: oskar setup (a source checkout needs \
./install.sh first)"
    return
  fi
  if ! systemctl --user --quiet is-active "$DOCTOR_UNIT_D" 2>/dev/null; then
    doc_fail "$what" "$DOCTOR_UNIT_D is $state but NOT active — the helper \
is not running; try: systemctl --user status $DOCTOR_UNIT_D, then \
oskar setup"
    return
  fi
  if [[ "$state" != "enabled" ]]; then
    doc_fail "$what" "$DOCTOR_UNIT_D is running but $state (it will not \
survive the next login); try: oskar setup"
    return
  fi
  doc_ok "$what" "$DOCTOR_UNIT_D enabled and active"
}

doctor_socket() {
  local what="control socket"
  case "$HELLO_REPLY" in
    "hello $PROTOCOL_VERSION")
      doc_ok "$what" "$DOCTOR_SOCKET answers hello $PROTOCOL_VERSION \
(ready: device and keymap live)"
      ;;
    "no socat")
      doc_unknown "$what" "cannot ask the helper — socat is not installed \
(pacman: socat)"
      ;;
    "no socket")
      doc_fail "$what" "$DOCTOR_SOCKET does not exist — no helper is \
serving it; try: oskar setup"
      ;;
    "err not ready")
      doc_fail "$what" "the helper is up but NOT ready — no keymap has \
been forwarded (the panel never completed a configure); try: \
omarchy restart shell"
      ;;
    silent)
      doc_fail "$what" "$DOCTOR_SOCKET exists but the helper did not \
answer in 2s; try: systemctl --user status $DOCTOR_UNIT_D, then \
oskar setup"
      ;;
    "err protocol"*)
      # The drift check owns the version comparison; this is its evidence.
      doc_fail "$what" "the helper refused protocol $PROTOCOL_VERSION \
(reply: $HELLO_REPLY) — the installed helper and this $MODE tree disagree; \
try: oskar upgrade"
      ;;
    *)
      doc_fail "$what" "unexpected reply '$HELLO_REPLY'; try: \
systemctl --user status $DOCTOR_UNIT_D"
      ;;
  esac
}

doctor_mode() {
  local what="install mode" target text points
  if [[ ! -d "$PAYLOAD" ]]; then
    doc_fail "$what" "the $MODE payload $PAYLOAD is MISSING (removed under \
a live install?); try: reinstall the $MODE payload, then oskar setup"
  fi
  if [[ -d "$DOCTOR_REG" && ! -L "$DOCTOR_REG" \
        && "$(cd "$DOCTOR_REG" && pwd -P)" == "$(cd "$PAYLOAD" 2>/dev/null && pwd -P)" ]]; then
    doc_ok "$what" "$MODE (self: $SELF); the registration is this install's \
own clone (omarchy plugin add)"
  elif [[ -e "$DOCTOR_REG" && ! -L "$DOCTOR_REG" ]]; then
    doc_fail "$what" "$DOCTOR_REG is a real directory (a git clone or a \
checkout), so the shell loads THAT, not the $MODE payload $PAYLOAD; try: \
remove or rename the directory, then oskar setup"
  elif [[ ! -L "$DOCTOR_REG" ]]; then
    doc_fail "$what" "no registration at $DOCTOR_REG — the shell has no \
plugin to load; try: oskar setup"
  else
    # realpath happily resolves a dangling link's text, so existence is
    # decided by following the link, not by realpath's output.
    text="$(readlink "$DOCTOR_REG")"
    if [[ ! -e "$DOCTOR_REG" ]]; then
      doc_fail "$what" "the registration $DOCTOR_REG is DANGLING (link \
text: $text — its payload was removed); try: oskar setup"
    else
      target="$(realpath "$DOCTOR_REG" 2>/dev/null || true)"
      if [[ "$target" == "$PAYLOAD" ]]; then
        doc_ok "$what" "$MODE (self: $SELF); registration -> $target"
      else
        doc_fail "$what" "the registration points at $target, not the \
$MODE payload $PAYLOAD — the shell loads a different install than this \
command manages; try: oskar setup"
      fi
    fi
  fi

  # ~/.local/bin shadows /usr/bin on default PATHs: a stale shadow is how
  # a bare `oskar setup` silently re-creates a migrated-away source
  # world. A DANGLING shadow is skipped by PATH lookup and is harmless,
  # so existence follows the link (-e, not -L).
  local shadow="PATH shadow"
  points="$(realpath "$DOCTOR_SHADOW" 2>/dev/null || true)"
  if [[ "$MODE" == "packaged" && -e "$DOCTOR_SHADOW" ]] \
      && record_matches "$DOCTOR_SHADOW"; then
    doc_fail "$shadow" "$DOCTOR_SHADOW shadows /usr/bin/oskar, so a \
bare oskar manages the source world instead of the package; try: \
oskar setup --migrate-source (it removes the shadow)"
  elif [[ "$MODE" == "packaged" && -e "$DOCTOR_SHADOW" ]]; then
    doc_fail "$shadow" "$DOCTOR_SHADOW shadows /usr/bin/oskar, and it is \
not the command OSKar installed (or it changed since), so OSKar will not \
remove it; try: move it yourself, or call /usr/bin/oskar by its full path"
  elif [[ "$MODE" == "packaged" ]]; then
    doc_ok "$shadow" "none ($DOCTOR_SHADOW absent; /usr/bin/oskar answers)"
  elif [[ -e "$DOCTOR_SHADOW" && "$points" != "$PAYLOAD/bin/oskar" ]]; then
    doc_fail "$shadow" "$DOCTOR_SHADOW resolves to ${points:-<unresolved>}, \
not this checkout's bin/oskar — a bare oskar runs a DIFFERENT \
install; try: oskar setup (install.sh re-points it)"
  elif [[ -e "$DOCTOR_SHADOW" ]]; then
    doc_ok "$shadow" "$DOCTOR_SHADOW -> this checkout's bin/oskar"
  else
    doc_ok "$shadow" "none ($DOCTOR_SHADOW absent)"
  fi

  # A source install's user unit OVERRIDES the packaged one while it
  # exists — the packaged helper can be enabled but never runs.
  if [[ "$MODE" == "packaged" ]]; then
    local override="legacy source override"
    if foreign_user_unit; then
      doc_fail "$override" "$USER_UNIT is a user unit OSKar did not \
install (or one edited since) and it OVERRIDES the packaged unit; OSKar \
will not touch it; try: rename or remove it yourself"
    elif record_matches "$USER_UNIT" || record_matches "$SOURCE_HELPER"; then
      doc_fail "$override" "a source install still stands \
($USER_UNIT and/or $SOURCE_HELPER) and OVERRIDES the packaged unit; try: \
oskar setup --migrate-source"
    else
      doc_ok "$override" "none; the packaged unit is the one systemd runs"
    fi
  elif [[ -x /usr/bin/oskar ]]; then
    doc_fail "two installs" "this checkout is the registered payload but \
/usr/bin/oskar also exists — PATH order decides which world a bare \
oskar manages; try: pick one (oskar setup --migrate-source \
from /usr/bin/oskar, or remove the package)"
  fi
}

doctor_keymap_share() {
  # The compositor must compile the helper's published keymap for
  # every physical keyboard, or two keymaps swap on every focus change
  # and each swap resets clients' group (types-the-wrong-alphabet
  # defect). A kb_file the USER set is legitimate input — name the
  # divergence, do not erase the distinction.
  local what="keymap share (input:kb_file)" raw kb
  local published="${DOCTOR_SOCKET%/*}/keymap.xkb"
  if command -v hyprctl >/dev/null 2>&1; then
    raw="$(hyprctl getoption input:kb_file -j 2>/dev/null || true)"
  fi
  if [[ -z "$raw" ]]; then
    doc_unknown "$what" "cannot read the compositor setting (hyprctl \
failed — run doctor inside the graphical session)"
    return
  fi
  if ! command -v jq >/dev/null 2>&1; then
    doc_unknown "$what" "cannot parse the compositor answer — jq is not \
installed (pacman: jq)"
    return
  fi
  kb="$(printf '%s' "$raw" | jq -r '.str // ""' 2>/dev/null)" || {
    doc_unknown "$what" "cannot parse the compositor answer ('${raw:0:60}')"
    return
  }
  if [[ "$kb" == "$published" ]]; then
    if [[ -f "$published" ]]; then
      doc_ok "$what" "input:kb_file == the helper's published $published"
    else
      doc_fail "$what" "input:kb_file points at $published but the file \
does not exist — the helper never published it (an old helper?); try: \
oskar upgrade"
    fi
  elif [[ -z "$kb" ]]; then
    doc_fail "$what" "the compositor carries NO kb_file, so the helper's \
keymap and the compositor's swap on every focus change and clients' group \
resets (§35's defect class — chats typing the previous alphabet); try: \
omarchy restart shell (the panel re-establishes the share)"
  else
    doc_fail "$what" "input:kb_file is '$kb', not the helper's published \
'$published' — two keymaps on one seat. If you set kb_file yourself the \
panel adopts it on its next configure; otherwise try: omarchy restart shell"
  fi
}

doctor_keycap_fallback() {
  # A silent degradation: the caps fall back to built-in tables (drawn
  # != typed on non-US layouts) and the only trace is a journal line.
  # The panel logs it once per layout through the shell's journal.
  local what="keycap fallback (last hour)" text hits first
  if [[ -n "$DOCTOR_JOURNAL_FILE" ]]; then
    text="$(cat "$DOCTOR_JOURNAL_FILE" 2>/dev/null || true)"
  elif command -v journalctl >/dev/null 2>&1; then
    text="$(journalctl --user --since "1 hour ago" --no-pager 2>/dev/null || true)"
  else
    doc_unknown "$what" "journalctl is not available"
    return
  fi
  hits="$(printf '%s\n' "$text" | grep -c "keycap fallback" || true)"
  if [[ "$hits" -eq 0 ]]; then
    doc_ok "$what" "no 'keycap fallback' lines in the user journal"
    return
  fi
  # The -m1 early exit SIGPIPEs printf under pipefail the moment the
  # journal text outgrows the pipe buffer past the hit — aborting the
  # run with 141 exactly when the degradation IS found, reproducible
  # with a multi-MB journal. Same guard the socket probes already use.
  first="$(printf '%s\n' "$text" | grep -m1 "keycap fallback" || true)"
  doc_fail "$what" "$hits line(s) in the last hour — the caps are silently \
degraded to the built-in tables (drawn != typed). \
First: ${first:0:120}; try: oskar upgrade, then rerun doctor"
}

doctor_layouts_groups() {
  # Sanity between the two authorities: the daemon's installed keymap
  # (how many groups it can type) and the compositor's layout list (what
  # the seat advertises). XKB holds at most four groups.
  local what="layouts vs installed groups" reply g daemon_groups=0 gen=""
  local devices lists count
  for g in 0 1 2 3; do
    reply="$(doctor_query "caps $g")"
    if [[ "$reply" == caps$'\t'* ]]; then
      daemon_groups=$((g + 1))
      [[ -z "$gen" ]] && gen="$(printf '%s' "$reply" | cut -f2)"
    else
      break
    fi
  done
  if ! command -v hyprctl >/dev/null 2>&1; then
    doc_unknown "$what" "hyprctl is not available — cannot read the \
compositor's layout list"
    return
  fi
  devices="$(hyprctl devices -j 2>/dev/null || true)"
  if [[ -z "$devices" ]]; then
    doc_unknown "$what" "hyprctl did not answer — run doctor inside the \
graphical session"
    return
  fi
  if ! command -v jq >/dev/null 2>&1; then
    doc_unknown "$what" "jq is not installed — cannot parse the device \
list (pacman: jq)"
    return
  fi
  lists="$(printf '%s' "$devices" |
    jq -r '[.keyboards[].layout // "" | select(. != "")] | unique | join(" ; ")' \
    2>/dev/null || true)"
  if [[ -z "$lists" ]]; then
    doc_unknown "$what" "no keyboard reports a layout list"
    return
  fi
  if [[ "$lists" == *" ; "* ]]; then
    doc_fail "$what" "keyboards carry DIFFERENT layout lists ($lists) — the \
seat is split (per-device kb_layout config or a half-finished switch; \
§34's works-one-time-in-ten class); try: switch once from the panel's \
language button, and check per-device kb_layout in hyprland.conf"
    return
  fi
  count="$(printf '%s' "$lists" | awk -F',' '{print NF}')"
  if [[ "$HELLO_REPLY" != "hello $PROTOCOL_VERSION" ]]; then
    doc_unknown "$what" "compositor lists '$lists' ($count) but the helper \
cannot be asked (see the control socket check)"
    return
  fi
  if [[ "$daemon_groups" -eq 0 ]]; then
    doc_fail "$what" "the helper holds NO keymap groups — no panel \
configure has landed on it; try: omarchy restart shell"
  elif [[ "$daemon_groups" -eq "$count" ]]; then
    doc_ok "$what" "compositor '$lists' ($count) == daemon groups \
($daemon_groups, generation ${gen:-?})"
  elif [[ "$daemon_groups" -lt "$count" ]]; then
    doc_fail "$what" "the helper's keymap carries $daemon_groups group(s) \
but the compositor lists $count ('$lists') — the panel's configure is \
stale (a shrunken list leaves the remembered group out of range, \
ticket 31's class); try: omarchy restart shell"
  else
    doc_fail "$what" "the helper's keymap carries $daemon_groups groups \
but the compositor lists $count ('$lists'); a custom kb_file may carry \
more groups than the list names — if you did not set one, try: \
omarchy restart shell"
  fi
}

doctor_seat() {
  # The helper reads the compositor's seat for the panel (protocol 7):
  # its keyboards, their groups, its kb_file. A helper that cannot is
  # still typing, but the panel's layout tracking has nothing to read.
  local what="seat backend" reply count
  if [[ "$HELLO_REPLY" != "hello $PROTOCOL_VERSION" ]]; then
    doc_unknown "$what" "the helper cannot be asked (see the control \
socket check)"
    return
  fi
  reply="$(doctor_query "seat")"
  case "$reply" in
    seat$'\t'*)
      # One "name" key per keyboard object in the helper's own JSON.
      # A seat with no keyboards is an answer, not a failed grep.
      count="$(printf '%s' "${reply#seat$'\t'}" | { grep -o '"name":' || true; } | wc -l)"
      doc_ok "$what" "the helper reads the compositor's seat: $count \
keyboard(s)"
      ;;
    "err no seat backend")
      doc_fail "$what" "the helper has no compositor to ask — \
HYPRLAND_INSTANCE_SIGNATURE was not in its environment when it started, \
or that Hyprland instance is gone; try: systemctl --user restart \
$DOCTOR_UNIT_D (from inside the graphical session)"
      ;;
    err*)
      doc_fail "$what" "the helper could not read the seat ($reply); try: \
systemctl --user restart $DOCTOR_UNIT_D"
      ;;
    *)
      doc_unknown "$what" "the helper did not answer 'seat' \
(reply: '${reply:0:60}')"
      ;;
  esac
}

doctor_theme_deps() {
  # The panel imports qs.Commons / qs.Ui from the Omarchy shell's own
  # tree — a shell without them (or no quickshell at all) leaves the
  # panel invisible with no error a fresh user would see.
  local what="theme dependencies" missing=()
  if ! command -v quickshell >/dev/null 2>&1; then
    doc_fail "$what" "quickshell is not installed — nothing can load the \
panel; try: pacman -S quickshell"
    return
  fi
  [[ -d "$DOCTOR_SHELL_ROOT/Commons" ]] ||
    missing+=("qs.Commons ($DOCTOR_SHELL_ROOT/Commons)")
  [[ -d "$DOCTOR_SHELL_ROOT/Ui" ]] ||
    missing+=("qs.Ui ($DOCTOR_SHELL_ROOT/Ui)")
  if ((${#missing[@]})); then
    doc_fail "$what" "the Omarchy shell's theme singletons are missing: \
${missing[*]} — the panel imports them and will not load (an invisible \
panel); try: reinstall the omarchy shell package"
  else
    doc_ok "$what" "quickshell present; $DOCTOR_SHELL_ROOT/{Commons,Ui} exist"
  fi
}

doctor_drift() {
  # The protocol gate is the designed drift detector: a panel
  # updated without its helper fails hello instead of typing nothing.
  # Version comparisons beyond that are evidence, not verdicts — a same-
  # version source edit leaves mtimes behind while the pair still agrees.
  local what="version drift" ver strays owned newest
  case "$HELLO_REPLY" in
    "no socat"|"no socket"|silent)
      doc_unknown "$what" "the helper was not asked ($HELLO_REPLY) — see \
the control socket check"
      return
      ;;
    "err not ready")
      # Not a version question: the socket check owns readiness.
      doc_unknown "$what" "the helper answered '$HELLO_REPLY' — see the \
control socket check"
      return
      ;;
    "hello $PROTOCOL_VERSION") : ;;
    *)
      # The socket check already named the raw reply; here it is drift.
      doc_fail "$what" "the helper did not negotiate protocol \
$PROTOCOL_VERSION (reply: $HELLO_REPLY) — the installed helper and this \
$MODE tree are from different versions; try: oskar upgrade"
      return
      ;;
  esac
  if [[ "$MODE" == "packaged" ]]; then
    ver="$(pacman -Q oskar 2>/dev/null || true)"
    if [[ -z "$ver" ]]; then
      doc_unknown "$what" "pacman does not know an oskar package, so \
the packaged payload at $PAYLOAD is unowned; try: reinstall the package"
      return
    fi
    owned="$(pacman -Qlq oskar 2>/dev/null | sort -u || true)"
    strays="$(find "$PAYLOAD" -type f 2>/dev/null | sort |
      comm -23 - <(printf '%s\n' "$owned") || true)"
    if [[ -n "$strays" ]]; then
      doc_fail "$what" "files no package owns sit in the payload (F7 \
class — they survive pacman -R and shadow a fresh install): \
$(printf '%s' "$strays" | head -n 3 | tr '\n' ' ')…; try: remove them and \
reinstall the package"
    else
      doc_ok "$what" "protocol $PROTOCOL_VERSION; $ver; every payload \
file owned by the package"
    fi
    return
  fi
  if [[ ! -f "$HELPER" ]]; then
    doc_fail "$what" "the helper binary $HELPER is MISSING; try: \
oskar setup (install.sh builds it)"
    return
  fi
  newest="$(find "$PAYLOAD/daemon/src" -name '*.rs' -newer "$HELPER" \
    -print -quit 2>/dev/null || true)"
  if [[ -n "$newest" ]]; then
    doc_ok "$what" "protocol $PROTOCOL_VERSION agrees; NOTE: $HELPER \
predates daemon/src edits ($newest is newer) — oskar upgrade \
rebuilds it"
  else
    doc_ok "$what" "protocol $PROTOCOL_VERSION; $HELPER is not older \
than daemon/src"
  fi
}

DOCTOR_CHECKS=(
  unit
  socket
  mode
  keymap-share
  keycap-fallback
  layouts-groups
  seat
  theme-deps
  drift
)

cmd_doctor() {
  detect_mode
  # Test seams (see the doctor comment block above); real paths default.
  DOCTOR_SOCKET="${OSKAR_DOCTOR_SOCKET:-$SOCKET}"
  DOCTOR_UNIT_D="${OSKAR_DOCTOR_UNIT:-$UNIT}"
  DOCTOR_REG="${OSKAR_DOCTOR_REGISTRATION:-$REGISTRATION}"
  DOCTOR_SHADOW="${OSKAR_DOCTOR_SHADOW:-$HOME/.local/bin/oskar}"
  DOCTOR_SHELL_ROOT="${OSKAR_DOCTOR_SHELL_ROOT:-/usr/share/omarchy/shell}"
  DOCTOR_JOURNAL_FILE="${OSKAR_DOCTOR_JOURNAL_FILE:-}"
  PAYLOAD="${OSKAR_DOCTOR_PAYLOAD:-$PAYLOAD}"
  HELPER="${OSKAR_DOCTOR_HELPER:-$HELPER}"

  say "doctor: $MODE install, payload $PAYLOAD"
  HELLO_REPLY="$(doctor_hello)"
  local check
  for check in "${DOCTOR_CHECKS[@]}"; do
    "doctor_${check//-/_}"
  done
  if ((DOCTOR_FAILS + DOCTOR_UNKNOWNS)); then
    say "doctor: $DOCTOR_FAILS failure(s), $DOCTOR_UNKNOWNS uncheckable — \
see the FAIL/unknown lines above"
    exit 1
  fi
  say "doctor: healthy"
  exit 0
}

case "${1:-}" in
setup) shift; cmd_setup "$@" ;;
upgrade) shift; cmd_upgrade "$@" ;;
status) [[ $# -eq 1 ]] || die "status takes no arguments"; cmd_status ;;
doctor) [[ $# -eq 1 ]] || die "doctor takes no arguments"; cmd_doctor ;;
teardown) [[ $# -eq 1 ]] || die "teardown takes no arguments"; cmd_teardown ;;
record) shift; cmd_record "$@" ;;
-h|--help|help)
  cat <<'EOF'
Usage: oskar <command>

  setup [--migrate-source] [--prebuilt <tarball>]
                            Activate: register the plugin, enable it in
                             the shell, enable/start the helper service.
                             Idempotent. --migrate-source moves a source
                             install's unit aside (kept, renamed) when the
                             install record proves it OSKar's.
  upgrade [--prebuilt <tarball>]
                            After a package/source update: reload unit
                             definitions, restart the helper, restart the
                             shell so the kept-loaded panel reloads.
  status                    Report payload, registration, plugin state,
                             unit state, socket and protocol. Read-only.
  doctor                    Diagnose a broken install: service, socket,
                             protocol, registration, keymap share, keycap
                             fallback, layouts, theme deps, versions.
                             Read-only; exits 1 when something is wrong.
  teardown                  Disable the plugin and unit, unlink the
                             registration if it is ours. Keeps config,
                             state and foreign directories.
  record matches <path> | write <path>... | forget <path>... | aside <path> <word>
                            The install record install.sh and
                             uninstall.sh consult: what OSKar wrote
                             outside its checkout, by digest.
EOF
  ;;
*)
  cat <<'EOF' >&2
Usage: oskar {setup|upgrade|status|doctor|teardown|record}
Run: oskar help
EOF
  exit 1
  ;;
esac
