# The package installs files only; activation is the user's one command
# (a package hook runs as root and must not guess a user's session bus).

post_install() {
  cat <<'EOF'
oskar installed (files only). Activate in your session with:

    oskar setup

See `oskar help` for upgrade, status and teardown.
EOF
}

post_upgrade() {
  cat <<'EOF'
oskar upgraded. Reload the helper and the panel with:

    oskar upgrade

EOF
}

pre_remove() {
  cat <<'EOF'
Removing oskar; /usr/bin/oskar goes with it. If you activated this
package with `oskar setup` and did not run `/usr/bin/oskar teardown`
first, these stay in your home and are yours to remove:

  - ~/.config/omarchy/plugins/io.github.vladkarok.oskar, when it is a
    symlink to /usr/share/oskar/plugin (then also:
    omarchy plugin disable io.github.vladkarok.oskar)
  - the oskar.service links to /usr/lib/systemd/user/oskar.service
    under ~/.config/systemd/user/*.wants/

A plugin-manager clone or a source checkout of OSKar is not affected;
do not tear it down for this. Config and state survive either way.
EOF
}
